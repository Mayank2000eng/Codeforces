import java.util.*;

public class tle {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();
        while (t-- > 0) {
            int n = sc.nextInt();
            int[] a = new int[n];
            for (int i = 0; i < n; i++) {
                a[i] = sc.nextInt();
            }
            if(n==1)
                System.out.println(0);
            else {
                int i=0,j=n-1;
                int ans=0;
                int flag=0;
                while(i<j){
                    if(a[j]!=a[i]){
                        if(flag==0)
                            ans=Math.abs(a[j]-a[i]);
                        else
                            ans=gcd(ans,Math.abs(a[i]-a[j]));
                        flag=1;
                    }
                    i++;
                    j--;
                }
                System.out.println(ans);
            }
        }
    }
    static int gcd(int a,int b){
            while (b != 0) {
                int temp = b;
                b = a % b;
                a = temp;
            }
            return a;
    }
}
