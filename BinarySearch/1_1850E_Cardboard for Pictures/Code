import java.util.Scanner;

public class tle {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {

            int n = sc.nextInt();
            long c = sc.nextLong();

            int[] arr = new int[n];

            for (int i = 0; i < n; i++) {
                arr[i] = sc.nextInt();
            }

            long l = 1, h = (long)1e9;

            while (l <= h) {

                long m = l + (h - l) / 2;

                int r = check(arr, c, m);

                if (r == 1) {
                    System.out.println(m);
                    break;
                }
                else if (r == 2) {
                    h = m - 1;
                }
                else {
                    l = m + 1;
                }
            }
        }
    }

    static int check(int[] arr, long c, long m) {

        long ans = 0;

        for (int i = 0; i < arr.length; i++) {

            long tem = arr[i] + 2 * m;

            if (tem > Long.MAX_VALUE / tem)
                return 2;

            long sq = tem * tem;

            if (ans > c - sq)
                return 2;

            ans += sq;
        }

        if (ans < c)
            return 0;

        return 1;
    }
}
